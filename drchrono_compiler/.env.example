# Local development settings. Copy this file to .env (same folder) and fill in the blanks.
# .env is git-ignored; never commit real values. On Render, set these in the dashboard instead.

# ── Django ──────────────────────────────────────────────────────────────────
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3

# ── DrChrono OAuth app ──────────────────────────────────────────────────────
DRCHRONO_CLIENT_ID=
DRCHRONO_CLIENT_SECRET=
# Must also be registered as a redirect URI in your DrChrono app settings.
DRCHRONO_REDIRECT_URI=http://localhost:8000/oauth/callback
# Space-separated; must match the scopes enabled on your DrChrono app.
DRCHRONO_SCOPES="clinical:read billing:read patients:read patients:summary:read calendar:read user:read"
# Allows the OAuth login over plain http://localhost. Never set this in production.
OAUTHLIB_INSECURE_TRANSPORT=1

# ── Practice details (balance report and HCFA-1500) ─────────────────────────
PROVIDER_NAME=
PROVIDER_NPI=
FEDERAL_TAX_ID=
PROVIDER_ACCOUNT_NUMBER=
PHYSICIAN_SIGNATURE=
PROVIDER_OFFICE_NAME=
PROVIDER_ADDRESS=
PROVIDER_CITY_STATE=
# Area code, one space, number: 555 123-4567
PROVIDER_PHONE=
PROVIDER_INFO=

# ── Production only (Render) ────────────────────────────────────────────────
# Number of gunicorn worker processes. Not needed for runserver.
# WEB_CONCURRENCY=4
